#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# mkota — Flashable ROM package builder
# Resolves the script directory so bundled resources (e.g. zstd-arm64) can
# be located regardless of where the caller invokes this script from.
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# ---------------------------------------------------------------------------
# Colour definitions
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# Configuration — values populated by CLI flags, env vars, or a config file.
# Precedence (highest → lowest): CLI flag > env var > config file.
# ---------------------------------------------------------------------------

# Capture any environment-level overrides before sourcing a config file so
# that sourcing cannot accidentally clobber them.
ENV_DEVICE_OVERRIDE="${MKOTA_DEVICE:-}"
ENV_FIRMWARE_OVERRIDE="${MKOTA_FIRMWARE:-}"
ENV_CODENAME_OVERRIDE="${MKOTA_CODENAME:-}"

# CLI-flag values (populated by parse_global_options)
DEVICE_CLI=""
FIRMWARE_CLI=""
CODENAME_CLI=""

# Config file path (from --config flag or MKOTA_CONFIG env var)
CONFIG_FILE="${MKOTA_CONFIG:-}"
ACTIVE_CONFIG_FILE=""

# When 1, print the generated update-binary to stdout and exit.
PRINT_UPDATE_BINARY=0

# Positional arguments collected after option parsing.
declare -a POSITIONAL_ARGS=()

declare -a CLEANUP_FILES=()
declare -a CLEANUP_DIRS=()

# ---------------------------------------------------------------------------
# Partition lists
# ---------------------------------------------------------------------------
SUPER_PARTITIONS=(
    "system" "vendor" "product"
    "system_dlkm" "system_ext" "vendor_dlkm" "odm_dlkm"
)
SUPER_TR_PARTITIONS=(
    "tr_carrier" "tr_company" "tr_mi" "tr_overlayfs"
    "tr_preload" "tr_product" "tr_region" "tr_theme"
)
SYSTEMS=(
    "boot" "dtbo" "init_boot"
    "vendor_boot" "vbmeta" "vbmeta_system" "vbmeta_vendor"
)
FIRMWARES=(
    "apusys" "cam_vpu1" "cam_vpu2" "cam_vpu3" "ccu"
    "connsys_bt" "dpm" "gpueb" "gz" "lk" "logo" "mcf_ota"
    "mcupm" "md1img" "mvpu_algo" "pi_img" "preloader_raw"
    "scp" "spmfw" "sspm" "tee" "tkv" "vcp"
)

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------
log() {
    local type="$1"
    local message="$2"
    case "$type" in
        "INFO")    echo -e "${BLUE}[INFO]${NC} $message" ;;
        "SUCCESS") echo -e "${GREEN}[SUCCESS]${NC} $message" ;;
        "WARNING") echo -e "${YELLOW}[WARNING]${NC} $message" ;;
        "ERROR")   echo -e "${RED}[ERROR]${NC} $message" ;;
    esac
}

handle_error() {
    log "ERROR" "$1"
    exit 1
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
    cat <<EOF
Usage: $(basename "$0") [options] <work_dir> <tmp_dir>

Options:
  --config <path>    Path to a configuration file exporting DEVICE, FIRMWARE, CODENAME.
  --device <value>   Override device name for this invocation.
  --firmware <value> Override firmware version for this invocation.
  --codename <value> Override device codename for this invocation.
  --print-update-binary [work_dir] [tmp_dir]
                     Print the generated update-binary script to stdout.
  -h, --help         Show this message.

Environment overrides:
  MKOTA_DEVICE                   Override device name.
  MKOTA_FIRMWARE                 Override firmware version.
  MKOTA_CODENAME                 Override device codename.
  MKOTA_CONFIG                   Default configuration file path.
EOF
}

# ---------------------------------------------------------------------------
# Dependency check
# ---------------------------------------------------------------------------
check_dependencies() {
    local deps=("zip" "zstd" "stat")
    for dep in "${deps[@]}"; do
        command -v "$dep" >/dev/null 2>&1 \
            || handle_error "$dep is required but not installed. Please install it and try again."
    done
}

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------
cleanup() {
    local file dir
    for dir in "${CLEANUP_DIRS[@]}"; do
        if [[ -d "$dir" ]]; then
            log "INFO" "Cleaning up temporary directory: $dir"
            rm -rf "$dir"
        fi
    done
    for file in "${CLEANUP_FILES[@]}"; do
        if [[ -f "$file" ]]; then
            rm -f "$file"
        fi
    done
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# Option parsing
# ---------------------------------------------------------------------------
parse_global_options() {
    POSITIONAL_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --config)
                [[ $# -ge 2 ]] || handle_error "--config requires a path argument"
                CONFIG_FILE="$2"
                shift 2
                ;;
            --device)
                [[ $# -ge 2 ]] || handle_error "--device requires a value"
                DEVICE_CLI="$2"
                shift 2
                ;;
            --firmware)
                [[ $# -ge 2 ]] || handle_error "--firmware requires a value"
                FIRMWARE_CLI="$2"
                shift 2
                ;;
            --codename)
                [[ $# -ge 2 ]] || handle_error "--codename requires a value"
                CODENAME_CLI="$2"
                shift 2
                ;;
            --print-update-binary)
                PRINT_UPDATE_BINARY=1
                shift
                POSITIONAL_ARGS=("$@")
                return
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            --)
                shift
                POSITIONAL_ARGS+=("$@")
                return
                ;;
            -*)
                handle_error "Unknown option: $1"
                ;;
            *)
                POSITIONAL_ARGS+=("$1")
                shift
                ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Configuration loading
# ---------------------------------------------------------------------------
load_configuration_file() {
    if [[ -n "$CONFIG_FILE" ]]; then
        [[ -f "$CONFIG_FILE" ]] || handle_error "Configuration file not found: $CONFIG_FILE"
        ACTIVE_CONFIG_FILE="$CONFIG_FILE"
        # shellcheck disable=SC1090
        source "$CONFIG_FILE"
        return
    fi

    local search_paths=(
        "$PWD/mkota.conf"
        "$SCRIPT_DIR/mkota.conf"
    )

    if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
        search_paths+=("${XDG_CONFIG_HOME}/mkota/config")
    elif [[ -n "${HOME:-}" ]]; then
        search_paths+=("${HOME}/.config/mkota/config")
    fi

    local candidate
    for candidate in "${search_paths[@]}"; do
        [[ -n "$candidate" && -f "$candidate" ]] || continue
        ACTIVE_CONFIG_FILE="$candidate"
        # shellcheck disable=SC1090
        source "$candidate"
        break
    done
}

apply_configuration_overrides() {
    # Environment overrides (lower priority than CLI flags)
    [[ -n "$ENV_DEVICE_OVERRIDE" ]]   && DEVICE="$ENV_DEVICE_OVERRIDE"
    [[ -n "$ENV_FIRMWARE_OVERRIDE" ]] && FIRMWARE="$ENV_FIRMWARE_OVERRIDE"
    [[ -n "$ENV_CODENAME_OVERRIDE" ]] && CODENAME="$ENV_CODENAME_OVERRIDE"

    # CLI flags (highest priority)
    [[ -n "$DEVICE_CLI" ]]   && DEVICE="$DEVICE_CLI"
    [[ -n "$FIRMWARE_CLI" ]] && FIRMWARE="$FIRMWARE_CLI"
    [[ -n "$CODENAME_CLI" ]] && CODENAME="$CODENAME_CLI"

    if [[ -n "$ACTIVE_CONFIG_FILE" ]] && (( ! PRINT_UPDATE_BINARY )); then
        log "INFO" "Loaded configuration from $ACTIVE_CONFIG_FILE"
    fi

    [[ -n "${DEVICE:-}" ]]   || handle_error "DEVICE is not configured. Use --device, environment variables, or a config file."
    [[ -n "${FIRMWARE:-}" ]] || handle_error "FIRMWARE is not configured. Use --firmware, environment variables, or a config file."
    [[ -n "${CODENAME:-}" ]] || handle_error "CODENAME is not configured. Use --codename, environment variables, or a config file."
}

# ---------------------------------------------------------------------------
# Utility helpers
# ---------------------------------------------------------------------------

# Resolve a directory to its canonical absolute path.
resolve_directory() {
    local dir="$1"
    [[ -d "$dir" ]] || handle_error "Directory not found: $dir"
    (cd -- "$dir" && pwd -P) || handle_error "Failed to resolve path for: $dir"
}

# Copy a file, preferring a hardlink to avoid duplicating data on disk.
# Falls back to a regular copy when hardlinking is not possible (e.g. across
# different filesystems).
fast_copy() {
    local src="$1"
    local dest="$2"
    if [[ -d "$dest" ]]; then
        dest="${dest}/$(basename "$src")"
    fi
    ln "$src" "$dest" 2>/dev/null || cp "$src" "$dest"
}

# Compress a single partition image with zstd using all available threads.
convert_partition() {
    local partition="$1"
    log "INFO" "Processing ${partition}.img"
    if ! zstd -T0 "${WORK_DIR}/${partition}.img" -o "$TMP_DIR/${partition}.img.zst"; then
        log "ERROR" "Failed to convert ${partition}.img"
        return 1
    fi
}

# Return the byte size of a file, compatible with both GNU and BSD stat.
get_img_size() {
    stat -c %s "$1" 2>/dev/null || stat -f %z "$1" 2>/dev/null
}

# ---------------------------------------------------------------------------
# update-binary emitters
#
# Each function below emits one logical section of the on-device shell script
# that TWRP/Magisk will execute when the flashable zip is installed.
# Splitting the single large generate_update_binary function into named
# emitters makes the intent of each section explicit and keeps each piece
# small enough to reason about independently.
# ---------------------------------------------------------------------------

# Emit the POSIX shell boilerplate: helper functions that run on the device.
_emit_update_binary_header() {
    cat <<'EOF'
#!/sbin/sh

OUTFD=/proc/self/fd/$2
ZIPFILE="$3"

ui_print() {
    printf 'ui_print %s\nui_print\n' "$1" >>"$OUTFD"
}

# Function to extract and flash a file to a partition
flash_partition() {
    src="$1"
    dest="$2"
    msg="$3"

    if [ "$#" -lt 3 ]; then
        partition_name=$(echo "$dest" | cut -d '/' -f 5)
        ui_print "- Flashing partition $partition_name"
    elif [ -n "$msg" ]; then
        ui_print "$msg"
    fi

    unzip -p "$ZIPFILE" "$src" >"$dest" || {
        ui_print "Error: Failed to flash $src to $dest"
        exit 1
    }
}

# Function to extract and flash a zstd compressed file to a partition
flash_partition_zstd() {
    src="$1"
    dest="$2"
    partition_name=$(echo "$dest" | cut -d '/' -f 5)

    ui_print "- Flashing partition $partition_name"
    unzip -p "$ZIPFILE" "$src" | /tmp/META-INF/zstd -c -d >"$dest" || {
        ui_print "Error: Failed to flash compressed $src to $dest"
        exit 1
    }
}

# Function to flash firmware to both slots while logging once
flash_firmware_both_slots() {
    img_file="$1"
    base_name="$2"

    flash_partition "$img_file" "/dev/block/by-name/${base_name}_a" "- Flashing partition ${base_name} to both slots"
    flash_partition "$img_file" "/dev/block/by-name/${base_name}_b" ""
}

getVolumeKey() {
    ui_print "- Listening to volume keys. Press [+] for 'Yes' and [-] for 'No'"
    while true; do
        keyInfo=$(getevent -qlc 1 | grep KEY_VOLUME)
        [ -z "$keyInfo" ] && continue
        isUpKey=$(printf '%s\n' "$keyInfo" | grep KEY_VOLUMEUP)
        if [ -n "$isUpKey" ]; then
            return 0
        else
            return 1
        fi
    done
}

checkDevice() {
    myDevice=$(getprop ro.product.device)
    [ -z "$myDevice" ] && myDevice=$(getprop ro.build.product)
    [ -z "$myDevice" ] && myDevice=$(getprop ro.product.name)
EOF

    # Device codename is substituted from the host environment at build time.
    cat <<EOF
    romDevice="$CODENAME"
EOF

    cat <<'EOF'
    if [ -z "$(echo "$myDevice" | grep -i "$romDevice")" ]; then
        ui_print "- Device code verification failed. Please double-check if this package matches your device model."
        ui_print "- Flashing the wrong package may cause bricking, and you will bear the consequences. Do you want to continue flashing?"
        if ! getVolumeKey; then
            ui_print "- You chose to abort flashing."
            exit 1
        else
            ui_print "- You chose to continue flashing."
        fi
    fi
}

checkExit() {
    status=$?
    if [ "$status" -ne 0 ]; then
        ui_print "Error: Exit status $status detected. There may be an issue with your super partition. Flash the stock super.img first, then retry. Exiting..."
        exit 1
    fi
}

unmountPartitions() {
    umount /system /system_root /vendor /product /system_ext /vendor_dlkm /odm_dlkm \
           /tr_carrier /tr_company /tr_mi /tr_preload /tr_product /tr_region /tr_theme 2>/dev/null
}

# Function to handle logical partition operations
manage_logical_partition() {
    operation="$1"
    partition="$2"
    size="$3"
    slot="$4"

    case "$operation" in
        clear)
            lptools unmap "$partition$slot" && lptools remove "$partition$slot"
            ;;
        create)
            lptools create "$partition$slot" "$size" || checkExit
            ;;
        map)
            lptools map "$partition$slot" || checkExit
            ;;
        unmap_map)
            lptools unmap "$partition$slot"
            lptools map "$partition$slot" || checkExit
            ;;
    esac
}

create_partitions_for_slot() {
    target_slot="$1"
    other_slot="$2"
    shift 2

    for spec in "$@"; do
        partition="${spec%%:*}"
        size="${spec#*:}"
        manage_logical_partition "create" "$partition" "$size" "$target_slot"
        manage_logical_partition "create" "$partition" "0" "$other_slot"
    done
}

process_partitions_for_slots() {
    operation="$1"
    shift

    for partition in "$@"; do
        manage_logical_partition "$operation" "$partition" "" "_a"
        manage_logical_partition "$operation" "$partition" "" "_b"
    done
}

unzip "$ZIPFILE" META-INF/zstd -d /tmp
chmod 0755 /tmp/META-INF/zstd

ui_print " "
EOF
}

# Emit the splash banner shown in the recovery UI.
_emit_update_binary_banner() {
    cat <<EOF
ui_print "============================================"
ui_print "██████     ██████     ██████  "
ui_print "██   ██    ██   ██    ██   ██ "
ui_print "██████     ██████     ██████  "
ui_print "██   ██    ██   ██    ██      "
ui_print "██   ██ ██ ██████  ██ ██      "
ui_print " "
ui_print "Flashable ROM by ramabondanp"
ui_print "Device : $DEVICE"
ui_print "Version: $FIRMWARE"
ui_print "============================================"
EOF
}

# Emit the preamble that runs before any flashing begins.
_emit_update_binary_preamble() {
    cat <<'EOF'

checkDevice

unmountPartitions

ui_print " "
SLOT=$(getprop ro.boot.slot_suffix)
ui_print "Checking boot slot... ${SLOT}"

# Remap
lptools clear-cow
checkExit

# Firmware
EOF
}

# Emit flash_firmware_both_slots calls for every firmware image present in WORK_DIR.
_emit_firmware_flashing() {
    local firmware_present=0
    local firmware

    for firmware in "${FIRMWARES[@]}"; do
        if [[ -f "${WORK_DIR}/${firmware}.img" ]]; then
            if (( firmware_present == 0 )); then
                echo "ui_print \" \""
                echo "ui_print \"Patching firmware to both slot...\""
                firmware_present=1
            fi
            echo "flash_firmware_both_slots \"firmware/${firmware}.img\" \"${firmware}\""
        fi
    done
}

# Emit the logical-partition management block (clear → create → map → flash → unmap_map).
_emit_super_partition_management() {
    local partition_names=()
    local partition_specs=()
    local partition size

    # Collect partitions that are actually present.
    for partition in "${SUPER_PARTITIONS[@]}" "${SUPER_TR_PARTITIONS[@]}"; do
        if [[ -f "${WORK_DIR}/${partition}.img" ]]; then
            partition_names+=("${partition}")
            size=$(get_img_size "${WORK_DIR}/${partition}.img")
            partition_specs+=("${partition}:${size}")
        fi
    done

    if (( ${#partition_names[@]} == 0 )); then
        return
    fi

    # --- Clear existing partitions ---
    echo "# Clear existing partitions"
    printf 'process_partitions_for_slots "clear"'
    for partition in "${partition_names[@]}"; do
        printf ' \\\n        "%s"' "$partition"
    done
    printf '\n'

    # --- Create new partitions (slot-aware) ---
    echo
    echo "# Create new partitions"
    printf "case \"\$SLOT\" in\n"
    printf "    \"_a\") OTHER_SLOT=\"_b\" ;;\n"
    printf "    \"_b\") OTHER_SLOT=\"_a\" ;;\n"
    printf "    *) ui_print \"- Unknown boot slot: \$SLOT\"; exit 1 ;;\n"
    printf "esac\n\n"
    printf 'create_partitions_for_slot "$SLOT" "$OTHER_SLOT"'
    for spec in "${partition_specs[@]}"; do
        printf ' \\\n        "%s"' "$spec"
    done
    printf '\n'

    # --- Map all partitions ---
    echo
    echo "# Map all partitions"
    printf 'process_partitions_for_slots "map"'
    for partition in "${partition_names[@]}"; do
        printf ' \\\n        "%s"' "$partition"
    done
    printf '\n'

    printf '\n'
    echo "ui_print \" \""
    echo "ui_print \"Patching system...\""

    # --- Flash system images to both slots ---
    local system
    for system in "${SYSTEMS[@]}"; do
        if [[ -f "${WORK_DIR}/${system}.img" ]]; then
            echo "flash_firmware_both_slots \"${system}.img\" \"${system}\""
        fi
    done

    # --- Flash super partition images (zstd compressed) ---
    for partition in "${SUPER_PARTITIONS[@]}" "${SUPER_TR_PARTITIONS[@]}"; do
        if [[ -f "${WORK_DIR}/${partition}.img" ]]; then
            echo "flash_partition_zstd \"${partition}.img.zst\" \"/dev/block/mapper/${partition}\$SLOT\""
        fi
    done

    # --- Final unmap/map to ensure clean mounts ---
    printf '\n'
    echo "# Final unmapping and mapping to ensure proper mounting"
    printf 'process_partitions_for_slots "unmap_map"'
    for partition in "${partition_names[@]}"; do
        printf ' \\\n        "%s"' "$partition"
    done
    printf '\n'
}

# Assemble the complete update-binary by calling each emitter in order.
generate_update_binary() {
    if [[ -n "$SCRIPT_FOLDER" ]]; then
        mkdir -p "$SCRIPT_FOLDER"
    fi

    {
        _emit_update_binary_header
        _emit_update_binary_banner
        _emit_update_binary_preamble
        _emit_firmware_flashing
        _emit_super_partition_management

        cat <<'EOF'

exit 0
EOF
    } > "$SCRIPT_FILE"
}

# ---------------------------------------------------------------------------
# --print-update-binary mode
# ---------------------------------------------------------------------------
print_update_binary() {
    WORK_DIR="${1:-${WORK_DIR:-}}"
    TMP_DIR="${2:-${TMP_DIR:-}}"
    [[ -n "$WORK_DIR" ]] || handle_error "WORK_DIR must be provided via argument or environment variable"
    [[ -n "$TMP_DIR" ]] || handle_error "TMP_DIR must be provided via argument or environment variable"
    WORK_DIR="$(resolve_directory "$WORK_DIR")"

    SCRIPT_FOLDER=""
    local tmp_script
    tmp_script="$(mktemp)" || handle_error "Failed to create temporary script file"
    SCRIPT_FILE="$tmp_script"
    CLEANUP_FILES+=("$SCRIPT_FILE")

    generate_update_binary
    cat "$SCRIPT_FILE"
}

# ---------------------------------------------------------------------------
# Main — orchestrates the full ROM build
# ---------------------------------------------------------------------------
main() {
    WORK_DIR="${1:-${WORK_DIR:-}}"
    TMP_DIR="${2:-${TMP_DIR:-}}"
    [[ -n "$WORK_DIR" ]] || handle_error "WORK_DIR must be provided via argument or environment variable"
    [[ -n "$TMP_DIR" ]] || handle_error "TMP_DIR must be provided via argument or environment variable"

    WORK_DIR="$(resolve_directory "$WORK_DIR")"
    SCRIPT_FOLDER="${TMP_DIR}/META-INF/com/google/android"
    SCRIPT_FILE="${SCRIPT_FOLDER}/update-binary"
    FIRMWARE_DIR="${TMP_DIR}/firmware"

    echo -e "\n${BLUE}╔═════════════════════════════════════════════════════════╗${NC}"
    echo -e   "${BLUE}║    Flashable ROM Creation Process Started               ║${NC}"
    echo -e   "${BLUE}║    Device: ${DEVICE}                                    ${NC}"
    echo -e   "${BLUE}║    Firmware: ${FIRMWARE}                                ${NC}"
    echo -e   "${BLUE}║    AutoScript by ramabondanp                            ║${NC}"
    echo -e   "${BLUE}╚═════════════════════════════════════════════════════════╝${NC}\n"

    check_dependencies

    mkdir -p "$TMP_DIR"      || handle_error "Failed to create temporary directory"
    CLEANUP_DIRS+=("$TMP_DIR")
    mkdir -p "$SCRIPT_FOLDER" || handle_error "Failed to create script folder"

    log "INFO" "Generating update-binary with improved functions"
    generate_update_binary

    # Compress super partition images in a background subshell so that file
    # copying (below) can proceed concurrently.
    log "INFO" "Converting and compressing partition images"
    local partition
    for partition in "${SUPER_PARTITIONS[@]}" "${SUPER_TR_PARTITIONS[@]}"; do
        if [[ -f "${WORK_DIR}/${partition}.img" ]]; then
            convert_partition "$partition" || handle_error "Failed to compress $partition"
        fi
    done &
    local compression_pid=$!

    # Copy the bundled arm64 zstd binary into the zip tree.
    # Note: Use regular 'cp' here to avoid permission failure with chmod on hardlinked files.
    local zstd_source="${SCRIPT_DIR}/zstd-arm64"
    [[ -f "$zstd_source" ]] || handle_error "Bundled zstd-arm64 binary not found"
    cp "$zstd_source" "$TMP_DIR/META-INF/zstd"        || handle_error "Failed to copy zstd binary"
    chmod 0755 "$TMP_DIR/META-INF/zstd"               || handle_error "Failed to set permissions on zstd binary"

    # Copy firmware images into firmware/ directory.
    log "INFO" "Copying firmware images"
    local firmware_dir_ready=0
    local firmware
    for firmware in "${FIRMWARES[@]}"; do
        if [[ -f "${WORK_DIR}/${firmware}.img" ]]; then
            if (( firmware_dir_ready == 0 )); then
                mkdir -p "$FIRMWARE_DIR" || handle_error "Failed to create firmware directory"
                firmware_dir_ready=1
            fi
            fast_copy "${WORK_DIR}/${firmware}.img" "$FIRMWARE_DIR" || handle_error "Failed to copy ${firmware}.img"
            log "SUCCESS" "Copied ${firmware}.img"
        else
            log "WARNING" "${firmware}.img not found, skipping"
        fi
    done

    # Copy system images (boot, dtbo, etc.) into the top-level zip directory.
    log "INFO" "Copying system images"
    local system
    for system in "${SYSTEMS[@]}"; do
        if [[ -f "${WORK_DIR}/${system}.img" ]]; then
            fast_copy "${WORK_DIR}/${system}.img" "$TMP_DIR" || handle_error "Failed to copy ${system}.img"
            log "SUCCESS" "Copied ${system}.img"
        else
            log "WARNING" "${system}.img not found, skipping"
        fi
    done

    # Wait for background compression before packaging.
    wait "$compression_pid" || handle_error "Partition compression failed"

    # Package everything into the flashable zip.
    log "INFO" "Creating final ROM zip"
    (cd "$TMP_DIR" && zip -r -n .zst "${WORK_DIR}/${FIRMWARE}-recovery-ab.zip" ./*) \
        || handle_error "Failed to create ROM zip"

    echo -e "\n${GREEN}╔════════════════════════════════════════════╗${NC}"
    echo -e   "${GREEN}║  Flashable ROM Creation Process Completed  ║${NC}"
    echo -e   "${GREEN}╚════════════════════════════════════════════╝${NC}\n"

    log "SUCCESS" "ROM creation process completed successfully."
    log "INFO" "ROM zip file: ${WORK_DIR}/${FIRMWARE}-recovery-ab.zip"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
parse_global_options "$@"
set -- "${POSITIONAL_ARGS[@]}"

load_configuration_file
apply_configuration_overrides

if (( PRINT_UPDATE_BINARY )); then
    print_update_binary "$@"
    exit 0
fi

main "$@"